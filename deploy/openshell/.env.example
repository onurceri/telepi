# Copy to .env and edit. Absolute host paths, mounted into the gateway at the same path.
# TELEPI_WORKSPACES must match the telepi server's TELEPI_WORKSPACES (and the local origin remotes of your projects
# must be inside TELEPI_REMOTES).
TELEPI_WORKSPACES=/absolute/path/to/telepi-workspaces
TELEPI_REMOTES=/absolute/path/to/git-remotes
